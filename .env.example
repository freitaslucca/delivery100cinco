# =========================================================
# 100 CINCO — Backend de Pedidos (variáveis de ambiente)
# Copie este arquivo para .env (local) ou cole na Vercel
# em Project Settings → Environment Variables
# =========================================================

# Porta em que o servidor escuta LOCALMENTE (Vercel ignora)
PORT=3000

# Ambiente: development | production
NODE_ENV=development

# String de conexão do MongoDB Atlas
# IMPORTANTE: inclua o nome do banco no path da URI!
# Ex.: mongodb+srv://USER:PASS@cluster.mongodb.net/delivery100cinco?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/delivery100cinco

# Segredo do JWT — gere com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-isto-por-um-segredo-aleatorio-de-no-minimo-64-caracteres

# Duração do token JWT (ex.: 12h, 7d, 30d)
JWT_EXPIRES_IN=7d

# Credenciais do admin inicial — usadas APENAS pelo script `npm run seed:admin`
# Pode apagar essas variáveis depois de rodar o seed
ADMIN_USERNAME=admin
ADMIN_PASSWORD=trocar-esta-senha-agora

# CORS — domínios permitidos (separados por vírgula)
# Em produção, use o domínio do seu deploy Vercel + custom domain se tiver
# Ex.: https://100cinco.vercel.app,https://www.100cinco.com.br
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# LOCAL ONLY: Express serve os HTMLs estáticos no dev (na Vercel essa flag NÃO importa
# porque a Vercel serve os HTMLs direto, sem passar pela função serverless)
SERVE_STATIC=true
