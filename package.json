{
  "name": "delivery100cinco",
  "version": "1.0.0",
  "description": "Site de pedidos + painel em tempo real — 100 Cinco Distribuidora",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch server/server.ts",
